	"styles": {
		"blocks": {
			"core/avatar": {
				"border": {
					"radius": "90px"
				}
			},
			"core/button": {
				"border": {
					"radius": "5px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"spacing": {
					"padding": {
						"bottom": "20px",
						"left": "32px",
						"right": "32px",
						"top": "20px"
					}
				},
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--bold)",
					"lineHeight": "1"
				}
			},
			"core/list": {
				"spacing": {
					"margin": {
						"bottom": "10px",
						"top": "10px"
					},
					"padding": {
						"left": "30px"
					}
				},
				"typography": {
					"lineHeight": "1.5"
				}
			},
			"core/read-more": {
				"border": {
					"radius": "5px"
				},
				"spacing": {
					"padding": {
						"bottom": "18px",
						"left": "32px",
						"right": "32px",
						"top": "18px"
					}
				},
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--bold)",
					"lineHeight": "1"
				}
			},
			"core/separator": {
				"spacing": {
					"margin": {
						"bottom": "1em",
						"top": "1em"
					}
				}
			},
			"core/site-title": {
				"color": {
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"textTransform": "uppercase"
				}
			},
			"core/table": {
				"spacing": {
					"margin": {
						"bottom": "1em",
						"top": "1em"
					},
					"padding": {
						"left": "20px"
					}
				}
			}
		},
		"color": {
			"text": "var(--wp--preset--color--black)"
		},
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--opensans)",
					"fontSize": "var(--wp--preset--font-size--xlarge)"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--opensans)",
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--opensans)",
					"fontSize": "var(--wp--preset--font-size--xmedium)"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--opensans)",
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--opensans)",
					"fontSize": "20px",
					"lineHeight": "1.5"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--opensans)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.6"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--black)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--opensans)",
					"fontWeight": "var(--wp--custom--typography--font-weight--semi-bold)",
					"lineHeight": "1.4"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--opensans)",
			"fontSize": "var(--wp--preset--font-size--small)",
			"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
			"lineHeight": "1.6"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header ( Default )"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer ( Default )"
		},
		{
			"area": "uncategorized",
			"name": "sidebar",
			"title": "Sidebar"
		},
		{
			"area": "uncategorized",
			"name": "post-meta",
			"title": "Post Meta"
		}
	],
	"version": 2
